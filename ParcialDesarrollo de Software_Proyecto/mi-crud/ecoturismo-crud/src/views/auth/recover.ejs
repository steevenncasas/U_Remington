<%- include("../partials/head") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header text-white fw-semibold" style="background:#2f5b2f;">
          Recuperar Usuario / Contraseña
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3">
            Digite su <b>usuario</b> o su <b>correo</b>. Se enviará una contraseña temporal al correo registrado.
          </p>

          <form method="post" action="/recuperar" class="vstack gap-3">
            <div>
              <label class="form-label">Usuario o correo</label>
              <input name="value" class="form-control" placeholder="usuario o correo@dominio.com" />
            </div>

            <div class="d-grid gap-2">
              <button class="btn btn-success" style="background:#2f5b2f;">Recuperar</button>
              <a href="/login" class="btn btn-secondary">Volver</a>
            </div>
          </form>
        </div>
      </div>

      <%- include("../partials/alerts") %>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
