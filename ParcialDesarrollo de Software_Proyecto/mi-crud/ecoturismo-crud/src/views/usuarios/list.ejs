<%- include("../partials/head") %>
<%- include("../partials/navbar") %>
<%- include("../partials/alerts") %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0">Gestión Usuario</h2>
    <div class="d-flex gap-2">
      <a class="btn btn-success" style="background:#2f5b2f;" href="/usuarios/nuevo">Crear</a>
      <a class="btn btn-secondary" href="/">Salir</a>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-12">
      <div class="card shadow-sm">
        <div class="card-header fw-semibold">Usuarios</div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped mb-0">
              <thead class="table-light">
                <tr>
                  <th>ID</th>
                  <th>Nombre de Usuario</th>
                  <th>Contraseña (hash)</th>
                  <th>IdPerfil</th>
                  <th>IdPersona</th>
                  <th>Estado</th>
                  <th style="width:220px;">Editar</th>
                </tr>
              </thead>
              <tbody>
                <% usuarios.forEach(u => { %>
                  <tr>
                    <td><%= u.idusuario %></td>
                    <td><%= u.nombreu %></td>
                    <td class="small text-muted"><%= u.contrasena %></td>
                    <td><%= u.idperfil %> - <%= u.perfil %></td>
                    <td><%= u.idpersona %> - <%= u.persona %></td>
                    <td>
                      <span class="badge <%= u.estado === 'Activo' ? 'bg-success' : 'bg-secondary' %>"><%= u.estado %></span>
                    </td>
                    <td class="d-flex gap-2">
                      <a class="btn btn-sm btn-outline-dark" href="/usuarios/<%= u.idusuario %>/editar">Modificar</a>
                      <form method="post" action="/usuarios/<%= u.idusuario %>/inhabilitar" onsubmit="return confirm('¿Inhabilitar usuario?')">
                        <button class="btn btn-sm btn-outline-danger" <%= u.estado === 'Inactivo' ? 'disabled' : '' %>>Inhabilitar</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-12">
      <div class="card shadow-sm mt-3">
        <div class="card-header fw-semibold"><%= edit && edit.idusuario ? 'Modificar' : 'Guardar' %></div>
        <div class="card-body">
          <% if (!edit) { %>
            <p class="text-muted">Presiona <b>Crear</b> o <b>Modificar</b>.</p>
          <% } else { %>
            <form method="post" action="<%= edit.idusuario ? ('/usuarios/' + edit.idusuario + '?_method=PUT') : '/usuarios' %>" class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Usuario</label>
                <input name="nombreu" class="form-control" value="<%= edit.nombreu %>" />
              </div>
              <div class="col-md-4">
                <label class="form-label">Contraseña <span class="text-muted small">(vacío = no cambia)</span></label>
                <input name="contrasena" type="password" class="form-control" value="" />
              </div>
              <div class="col-md-4">
                <label class="form-label">Perfil</label>
                <select name="idperfil" class="form-select">
                  <option value="">Seleccione</option>
                  <% perfiles.forEach(p => { %>
                    <option value="<%= p.idperfil %>" <%= String(edit.idperfil) === String(p.idperfil) ? 'selected' : '' %>><%= p.idperfil %> - <%= p.descripc %></option>
                  <% }) %>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label">Persona</label>
                <select name="idpersona" class="form-select">
                  <option value="">Seleccione</option>
                  <% personas.forEach(p => { %>
                    <option value="<%= p.idpersona %>" <%= String(edit.idpersona) === String(p.idpersona) ? 'selected' : '' %>><%= p.idpersona %> - <%= p.label %></option>
                  <% }) %>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select">
                  <option value="Activo" <%= edit.estado === 'Activo' ? 'selected' : '' %>>Activo</option>
                  <option value="Inactivo" <%= edit.estado === 'Inactivo' ? 'selected' : '' %>>Inactivo</option>
                </select>
              </div>

              <div class="col-12 d-grid gap-2">
                <button class="btn btn-success" style="background:#2f5b2f;"><%= edit.idusuario ? 'Actualizar' : 'Guardar Usuario' %></button>
                <a class="btn btn-secondary" href="/usuarios">Cancelar</a>
              </div>
            </form>
          <% } %>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include("../partials/footer") %>
