<div class="container mt-3">
  <% if (messages.error && messages.error.length) { %>
    <div class="alert alert-danger"><%= messages.error.join(" | ") %></div>
  <% } %>
  <% if (messages.success && messages.success.length) { %>
    <div class="alert alert-success"><%= messages.success.join(" | ") %></div>
  <% } %>
  <% if (messages.info && messages.info.length) { %>
    <div class="alert alert-info"><%= messages.info.join(" | ") %></div>
  <% } %>
</div>
