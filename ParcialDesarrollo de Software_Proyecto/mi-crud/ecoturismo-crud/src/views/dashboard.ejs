<%- include("./partials/head") %>
<%- include("./partials/navbar") %>
<%- include("./partials/alerts") %>

<div class="container py-4">
  <div class="card shadow-sm overflow-hidden">
    <div class="card-body p-0">
      <div class="position-relative">
        <img
          src="https://images.unsplash.com/photo-1526336024174-e58f5cdd8e13?auto=format&fit=crop&w=1600&q=60"
          class="w-100" style="max-height:420px; object-fit:cover;"
          alt="Ecoturismo" />
        <div class="position-absolute top-50 start-50 translate-middle text-center text-white">
          <div class="p-4 rounded" style="background:rgba(0,0,0,.45);">
            <h1 class="h3 fw-bold mb-2">Descubre la Biodiversidad Aviar</h1>
            <p class="mb-0">Más de 300 especies de aves en la selva del Pacífico Colombiano</p>
          </div>
        </div>
      </div>

      <div class="p-3">
        <p class="mb-0">
          Sesión iniciada como: <b><%= currentUser.nombreu %></b> (<%= currentUser.perfil %>)
        </p>
      </div>
    </div>
  </div>
</div>

<%- include("./partials/footer") %>
