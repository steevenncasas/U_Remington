<%- include("../partials/head") %>
<%- include("../partials/navbar") %>
<%- include("../partials/alerts") %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0">Gestión Perfil</h2>
    <div class="d-flex gap-2">
      <a class="btn btn-success" style="background:#2f5b2f;" href="/perfiles/nuevo">Crear</a>
      <a class="btn btn-secondary" href="/">Salir</a>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-header fw-semibold">Consultar</div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped mb-0">
              <thead class="table-light">
                <tr>
                  <th>ID</th>
                  <th>Descripción</th>
                  <th>Estado</th>
                  <th style="width:220px;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% perfiles.forEach(p => { %>
                  <tr>
                    <td><%= p.idperfil %></td>
                    <td><%= p.descripc %></td>
                    <td>
                      <span class="badge <%= p.estado === 'Activo' ? 'bg-success' : 'bg-secondary' %>">
                        <%= p.estado %>
                      </span>
                    </td>
                    <td class="d-flex gap-2">
                      <a class="btn btn-sm btn-outline-dark" href="/perfiles/<%= p.idperfil %>/editar">Modificar</a>
                      <form method="post" action="/perfiles/<%= p.idperfil %>/inhabilitar" onsubmit="return confirm('¿Inhabilitar perfil?')">
                        <button class="btn btn-sm btn-outline-danger" <%= p.estado === 'Inactivo' ? 'disabled' : '' %>>Inhabilitar</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card shadow-sm">
        <div class="card-header fw-semibold">
          <%= edit && edit.idperfil ? 'Modificar' : 'Guardar' %>
        </div>
        <div class="card-body">
          <% if (!edit) { %>
            <p class="text-muted">Presiona <b>Crear</b> o selecciona <b>Modificar</b> en la tabla.</p>
          <% } else { %>
            <form method="post" action="<%= edit.idperfil ? ('/perfiles/' + edit.idperfil + '?_method=PUT') : '/perfiles' %>" class="vstack gap-3">
              <div>
                <label class="form-label">Descripción</label>
                <input name="descripc" class="form-control" value="<%= edit.descripc %>" />
              </div>
              <div>
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select">
                  <option value="Activo" <%= edit.estado === 'Activo' ? 'selected' : '' %>>Activo</option>
                  <option value="Inactivo" <%= edit.estado === 'Inactivo' ? 'selected' : '' %>>Inactivo</option>
                </select>
              </div>

              <div class="d-grid gap-2">
                <button class="btn btn-success" style="background:#2f5b2f;">
                  <%= edit.idperfil ? 'Actualizar' : 'Guardar Perfil' %>
                </button>
                <a class="btn btn-secondary" href="/perfiles">Cancelar</a>
              </div>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
